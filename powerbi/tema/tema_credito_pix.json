{
  "name": "Crédito e Pix PJ",
  "dataColors": [
    "#1E5EFF",
    "#00B8A9",
    "#F6A609",
    "#E5484D",
    "#7C5CFF",
    "#2BB673",
    "#FF7A45",
    "#14365D",
    "#8892A6",
    "#B4C2D8"
  ],
  "background": "#FFFFFF",
  "foreground": "#14213D",
