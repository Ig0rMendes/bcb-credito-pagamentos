            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
