	measure 'KPI Fatia B2B variação 5 anos' =
			VAR a = [KPI Fatia B2B]
			VAR b = [KPI Fatia B2B (5 anos antes)]
			RETURN
			    IF (
			        ISBLANK ( a ) || ISBLANK ( b ),
			        BLANK (),
			        SUBSTITUTE ( FORMAT ( ( a - b ) * 100, "+0.00;-0.00" ), ".", "," ) & " p.p."
			    )
