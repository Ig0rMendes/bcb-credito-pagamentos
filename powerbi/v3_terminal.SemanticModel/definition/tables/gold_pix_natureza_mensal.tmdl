	measure 'KPI Contexto amostra' =
			VAR n =
			    COUNTROWS ( FILTER ( ALL ( gold_defasagem_juros_inadimplencia ), gold_defasagem_juros_inadimplencia[na_amostra_comum] ) )
			RETURN
			    UNICHAR ( 9679 ) & " amostra fixa de " & n & " meses · não muda com o filtro de período"
		displayFolder: KPIs – variação
		lineageTag: 4e53983a-d3d4-53e4-b433-81073a477e03

	measure 'KPI Cor contexto' = "#7F8DA6"
