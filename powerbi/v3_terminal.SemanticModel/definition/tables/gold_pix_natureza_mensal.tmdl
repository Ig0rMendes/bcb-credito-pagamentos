table gold_pix_natureza_mensal
	lineageTag: 6f2fe3a3-1052-4acc-b23b-3b5f3469af63

	measure '_Valor Pix' = SUM ( gold_pix_natureza_mensal[valor] )
		lineageTag: 8264663c-ce42-45a1-875d-983673601f4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Quantidade Pix' = SUM ( gold_pix_natureza_mensal[quantidade] )
		formatString: 0
		lineageTag: 3bf7683c-a487-4a0e-af05-3eadb7d7bfa8

	measure '_Ticket Médio' = DIVIDE ( [_Valor Pix], [_Quantidade Pix] )
		lineageTag: 4588a4dd-4639-41d9-b039-82f603e84653

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Participação no Valor' =
			
			DIVIDE (
			    [_Valor Pix],
			    CALCULATE ( [_Valor Pix], REMOVEFILTERS ( dNatureza ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e10ad39-5b8c-4316-b14a-242219baa9bf

	measure '_Valor Pix Empresas' = SUM ( gold_pix_empresas_forma_iniciacao[valor] )
		lineageTag: b88dc9ca-ae32-41c7-bd98-c4b7df676a22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _Selic = AVERAGE ( gold_defasagem_juros_inadimplencia[selic_meta] )
		lineageTag: bacd1f9f-ebb8-4881-95db-370946e9301d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Inadimplência PJ' = AVERAGE ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] )
		lineageTag: 7059e97e-baeb-4173-b99a-ff94e7b40131

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Inadimplência PJ (último mês)' =
			
			VAR ultimo =
			    CALCULATE (
			        MAX ( gold_defasagem_juros_inadimplencia[data] ),
			        FILTER (
			            ALL ( gold_defasagem_juros_inadimplencia ),
			            NOT ISBLANK ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] )
			        )
			    )
			RETURN
			    CALCULATE (
			        AVERAGE ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] ),
			        FILTER ( ALL ( gold_defasagem_juros_inadimplencia ), gold_defasagem_juros_inadimplencia[data] = ultimo )
			    )
		formatString: 0.00"%"
		lineageTag: 9f122640-61c5-4300-91da-abaa8adb92fc

		annotation PBI_FormatHint = {"isCustom":true}

	measure '_Selic (último mês)' =
			
			VAR ultimo =
			    CALCULATE (
			        MAX ( gold_defasagem_juros_inadimplencia[data] ),
			        FILTER (
			            ALL ( gold_defasagem_juros_inadimplencia ),
			            NOT ISBLANK ( gold_defasagem_juros_inadimplencia[selic_meta] )
			        )
			    )
			RETURN
			    CALCULATE (
			        AVERAGE ( gold_defasagem_juros_inadimplencia[selic_meta] ),
			        FILTER ( ALL ( gold_defasagem_juros_inadimplencia ), gold_defasagem_juros_inadimplencia[data] = ultimo )
			    )
		formatString: 0.00"%"
		lineageTag: 398abbc6-6c38-448e-9457-6e68cb2b9d84

		annotation PBI_FormatHint = {"isCustom":true}

	measure '_Mês de referência' =
			
			VAR ultimo =
			    CALCULATE (
			        MAX ( gold_defasagem_juros_inadimplencia[data] ),
			        FILTER (
			            ALL ( gold_defasagem_juros_inadimplencia ),
			            NOT ISBLANK ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] )
			        )
			    )
			VAR meses = "jan,fev,mar,abr,mai,jun,jul,ago,set,out,nov,dez"
			RETURN
			    "Dados de crédito até " & MID ( meses, ( MONTH ( ultimo ) - 1 ) * 4 + 1, 3 ) & "/" & YEAR ( ultimo )
		lineageTag: 05cdb46b-fc2f-4871-88a6-8e90435567a2

	measure '_Participação B2B (último mês)' =
			
			VAR ultimo = CALCULATE ( MAX ( gold_pix_natureza_mensal[data] ), ALL ( gold_pix_natureza_mensal ) )
			RETURN
			    CALCULATE ( [_Participação no Valor], dNatureza[natureza] = "B2B", dCalendario[data] = ultimo )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 59316572-e499-4463-94af-dc2b1998cbec

	measure '_Participação B2B (5 anos antes)' =
			
			VAR ultimo = CALCULATE ( MAX ( gold_pix_natureza_mensal[data] ), ALL ( gold_pix_natureza_mensal ) )
			RETURN
			    CALCULATE ( [_Participação no Valor], dNatureza[natureza] = "B2B", dCalendario[data] = EDATE ( ultimo, -60 ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 135f7c7e-e769-4804-b575-dbf5325d4a84

	measure '_Defasagem de pico (meses)' =
			
			VAR t =
			    FILTER (
			        ALL ( gold_correlacao_defasagem ),
			        gold_correlacao_defasagem[indicador_juros] = "juro_real_ex_post"
			            && gold_correlacao_defasagem[base] = "variacao_12m"
			    )
			VAR maior = MAXX ( t, gold_correlacao_defasagem[correlacao] )
			RETURN
			    MAXX ( FILTER ( t, gold_correlacao_defasagem[correlacao] = maior ), gold_correlacao_defasagem[defasagem_meses] )
		formatString: 0
		lineageTag: 142dc23d-bee4-47e4-9177-a5dc947860c1

	measure '_Efeito do juro real (p.p.)' =
			
			VAR amostra =
			    FILTER (
			        ALL ( gold_defasagem_juros_inadimplencia ),
			        gold_defasagem_juros_inadimplencia[na_amostra_comum]
			    )
			VAR reg =
			    LINESTX (
			        amostra,
			        gold_defasagem_juros_inadimplencia[inadimplencia_pj_var_12m],
			        gold_defasagem_juros_inadimplencia[juro_real_var_12m_6m_antes]
			    )
			RETURN
			    MAXX ( reg, [Slope1] )
		lineageTag: bdc9478f-5c90-44cb-bcc7-80c73d9a10c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_R² da regressão' =
			
			VAR amostra =
			    FILTER (
			        ALL ( gold_defasagem_juros_inadimplencia ),
			        gold_defasagem_juros_inadimplencia[na_amostra_comum]
			    )
			VAR reg =
			    LINESTX (
			        amostra,
			        gold_defasagem_juros_inadimplencia[inadimplencia_pj_var_12m],
			        gold_defasagem_juros_inadimplencia[juro_real_var_12m_6m_antes]
			    )
			RETURN
			    MAXX ( reg, [CoefficientOfDetermination] )
		lineageTag: 3e473d78-76d9-42f7-9a85-185020c56bf4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Correlação (variação 12m)' =
			
			CALCULATE (
			    SUM ( gold_correlacao_defasagem[correlacao] ),
			    gold_correlacao_defasagem[base] = "variacao_12m"
			)
		lineageTag: 33174113-e40e-491a-b713-dfc0e2d594d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Variação B2B em 5 anos' =
			
			VAR pp = ( [_Participação B2B (último mês)] - [_Participação B2B (5 anos antes)] ) * 100
			RETURN SUBSTITUTE ( FORMAT ( pp, "+0.00;-0.00" ), ".", "," ) & " p.p."
		lineageTag: 3fb58f50-6bf2-4a0b-914b-e603974dd907

	measure 'KPI Mês inadimplência' =
			CALCULATE (
			    MAX ( gold_defasagem_juros_inadimplencia[data] ),
			    NOT ISBLANK ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] )
			)
		formatString: dd/mm/yyyy
		displayFolder: KPIs – variação
		lineageTag: 7e99f9fd-95d0-5e3f-9e41-45d622ca07ee

	measure 'KPI Inadimplência' =
			VAR m = [KPI Mês inadimplência]
			RETURN
			    CALCULATE ( AVERAGE ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] ), dCalendario[data] = m )
		formatString: 0.00"%"
		displayFolder: KPIs – variação
		lineageTag: c8d51794-aa78-52a4-96ae-9bbc0414200d

	measure 'KPI Inadimplência (mês anterior)' =
			VAR m = [KPI Mês inadimplência]
			RETURN
			    CALCULATE ( AVERAGE ( gold_defasagem_juros_inadimplencia[inadimplencia_pj] ), dCalendario[data] = EDATE ( m, -1 ) )
		formatString: 0.00"%"
		displayFolder: KPIs – variação
		lineageTag: 74401a8c-4ab9-5eb0-badb-c3f1caf3aed7

	measure 'KPI Inadimplência Δ (p.p.)' =
			VAR a = [KPI Inadimplência]
			VAR b = [KPI Inadimplência (mês anterior)]
			RETURN
			    IF ( ISBLANK ( a ) || ISBLANK ( b ), BLANK (), a - b )
		formatString: 0.00
		displayFolder: KPIs – variação
		lineageTag: 4acf746d-f95e-501b-802d-e6c45624b9b1

	measure 'KPI Inadimplência Δ texto' =
			VAR d = [KPI Inadimplência Δ (p.p.)]
			VAR p = EDATE ( [KPI Mês inadimplência], -1 )
			VAR meses = "jan,fev,mar,abr,mai,jun,jul,ago,set,out,nov,dez"
			VAR rotulo = MID ( meses, ( MONTH ( p ) - 1 ) * 4 + 1, 3 ) & "/" & RIGHT ( FORMAT ( YEAR ( p ), "0" ), 2 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), BLANK (),
			        ABS ( d ) < 0.005, UNICHAR ( 9679 ) & " estável vs " & rotulo,
			        IF ( d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & SUBSTITUTE ( FORMAT ( ABS ( d ), "0.00" ), ".", "," ) & " p.p. vs " & rotulo
			    )
		displayFolder: KPIs – variação
		lineageTag: ad137a1d-c43d-54da-a9bc-65a2ce02728e

	measure 'KPI Inadimplência Δ cor' =
			VAR d = [KPI Inadimplência Δ (p.p.)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( d ) || ABS ( d ) < 0.005, "#7F8DA6", d > 0, "#F85149", "#5DCAA5" )
		displayFolder: KPIs – variação
		lineageTag: 86d58bd5-0a83-546f-be44-933c5a66da50

