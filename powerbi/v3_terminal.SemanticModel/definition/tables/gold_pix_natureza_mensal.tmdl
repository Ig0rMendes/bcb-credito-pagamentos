	measure 'KPI Fatia B2B 5 anos texto' =
			VAR a = [KPI Fatia B2B]
			VAR b = [KPI Fatia B2B (5 anos antes)]
			VAR p = EDATE ( [KPI Mês Pix], -60 )
			VAR meses = "jan,fev,mar,abr,mai,jun,jul,ago,set,out,nov,dez"
			RETURN
			    IF (
			        ISBLANK ( a ) || ISBLANK ( b ),
			        BLANK (),
			        SUBSTITUTE ( FORMAT ( b * 100, "0.00" ), ".", "," ) & "% " & UNICHAR ( 8594 ) & " " & SUBSTITUTE ( FORMAT ( a * 100, "0.00" ), ".", "," ) & "% desde " & MID ( meses, ( MONTH ( p ) - 1 ) * 4 + 1, 3 ) & "/" & RIGHT ( FORMAT ( YEAR ( p ), "0" ), 2 )
			    )
		displayFolder: KPIs – variação
