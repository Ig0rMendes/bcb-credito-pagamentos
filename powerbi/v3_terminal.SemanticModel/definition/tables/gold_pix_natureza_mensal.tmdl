	measure '_Fatia da forma de iniciação' =
			VAR total =
			    CALCULATE ( SUM ( gold_pix_empresas_forma_iniciacao[valor] ), REMOVEFILTERS ( gold_pix_empresas_forma_iniciacao[forma_grupo] ) )
			VAR nao_disponivel =
			    CALCULATE ( SUM ( gold_pix_empresas_forma_iniciacao[valor] ), gold_pix_empresas_forma_iniciacao[forma_grupo] = "Não disponível" )
			RETURN
			    -- antes de jul/2021 o BCB não informa a forma; entre ago e set/2021 a chave Pix salta 7 p.p. de uma vez
			    -- (provável mudança de classificação). O gráfico começa em set/2021 para comparar meses comparáveis.
			    IF ( MAX ( dCalendario[data] ) < DATE ( 2021, 9, 1 ) || DIVIDE ( nao_disponivel, total ) > 0.5, BLANK (), DIVIDE ( SUM ( gold_pix_empresas_forma_iniciacao[valor] ), total ) )
		formatString: 0%
		lineageTag: 8b15cd8c-0115-5ede-99a0-312511e4ac14

	measure '_Rótulo mês Pix' =
			VAR m = [KPI Mês Pix]
			VAR meses = "jan,fev,mar,abr,mai,jun,jul,ago,set,out,nov,dez"
			RETURN
			    MID ( meses, ( MONTH ( m ) - 1 ) * 4 + 1, 3 ) & "/" & RIGHT ( FORMAT ( YEAR ( m ), "0" ), 2 )
		lineageTag: d08c7529-820c-4d8f-b610-b9d5bda3a8a3

	measure '_Participação no Valor (último mês)' =
			VAR m = [KPI Mês Pix]
			RETURN
			    CALCULATE ( [_Participação no Valor], dCalendario[data] = m )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 17b4b3a7-169a-47d3-9c3e-df60c2c9d771

	measure '_Ticket médio (12 meses)' =
			VAR m = [KPI Mês Pix]
			RETURN
			    CALCULATE ( [_Ticket Médio], dCalendario[data] > EDATE ( m, -12 ), dCalendario[data] <= m )
		formatString: #,0.00
		lineageTag: e2d3760d-509c-4f72-864b-e1e40da20261

	measure '_Título fatia último mês' =
			"Fatia de cada natureza no valor do Pix em " & [_Rótulo mês Pix] & ", último mês do período (B2B = empresa paga empresa; P2P = pessoa paga pessoa)"
		lineageTag: 94233a1d-5adf-4608-8d07-daa67eb00401

	measure '_Título ticket 12 meses' =
			"Ticket médio por natureza nos 12 meses até " & [_Rótulo mês Pix] & " (R$ nominais por transação)"
		lineageTag: 4428eab7-35d4-48eb-b36c-945043d6893a

	measure '_Defasagem de pico (faixa)' =
			-- o pico sozinho dá falsa precisão: mostra também as defasagens com correlação até 0,05 abaixo dele
			VAR t =
			    FILTER (
			        ALL ( gold_correlacao_defasagem ),
			        gold_correlacao_defasagem[indicador_juros] = "juro_real_ex_post"
			            && gold_correlacao_defasagem[base] = "variacao_12m"
			    )
			VAR maior = MAXX ( t, gold_correlacao_defasagem[correlacao] )
			VAR pico = MAXX ( FILTER ( t, gold_correlacao_defasagem[correlacao] = maior ), gold_correlacao_defasagem[defasagem_meses] )
			VAR perto = FILTER ( t, gold_correlacao_defasagem[correlacao] >= maior - 0.05 )
			RETURN
			    pico & " meses (faixa de " & MINX ( perto, gold_correlacao_defasagem[defasagem_meses] ) & " a "
			        & MAXX ( perto, gold_correlacao_defasagem[defasagem_meses] ) & ")"
		lineageTag: f682f867-7d89-43b2-8680-4ff087944967

