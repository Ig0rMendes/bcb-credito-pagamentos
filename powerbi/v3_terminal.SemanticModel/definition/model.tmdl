annotation PBI_ProTooling = ["DevMode"]

ref table gold_correlacao_defasagem
ref table gold_defasagem_juros_inadimplencia
ref table gold_pix_empresas_forma_iniciacao
ref table gold_pix_natureza_mensal
ref table dCalendario
ref table dNatureza

ref cultureInfo en-US

